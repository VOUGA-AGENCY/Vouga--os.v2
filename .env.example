# The web application currently runs on loopback; storage can be local or Supabase.
VOUGA_LOCAL_MODE=1
# Synthetic accounts are created once, at the first login.
VOUGA_DEMO_PASSWORD=vouga-local-2026
# Optional absolute directory; defaults to .local within this project.
# VOUGA_DATA_DIR=/absolute/path/to/local/data

# Enable only after SQL installation and a verified db:migrate.
VOUGA_STORAGE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for this secret.
SUPABASE_SECRET_KEY=

# Production only: set VOUGA_LOCAL_MODE=0 and the exact HTTPS origin.
# VOUGA_APP_ORIGIN=https://os.vouga-agency.pt
ORS_API_KEY=