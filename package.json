{
  "name": "vouga-os-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1 --port 3100",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint src tests",
    "test": "bun --bun vitest run",
    "setup": "bun scripts/setup.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "format": "bun --bun prettier --write src tests docs README.md",
    "desktop:build": "bash desktop/macos/build.sh",
    "integrations:worker": "bun --conditions=react-server scripts/integration-worker.ts",
    "db:preview": "bun --conditions=react-server scripts/migrate-supabase.ts",
    "db:migrate": "bun --conditions=react-server scripts/migrate-supabase.ts --apply",
    "meetings:preview": "bun --conditions=react-server scripts/import-meetings.ts",
    "meetings:migrate": "bun --conditions=react-server scripts/import-meetings.ts --apply",
    "meetings:supabase": "bun --conditions=react-server scripts/import-meetings-supabase.ts",
    "meetings:supabase:apply": "bun --conditions=react-server scripts/import-meetings-supabase.ts --apply",
    "integrations:check": "bun --conditions=react-server scripts/check-integrations.ts",
    "prospects:sync": "bun --conditions=react-server scripts/sync-prospects.ts",
    "prospects:import": "bun --conditions=react-server scripts/import-prospects.ts",
    "prospects:migrate": "bun --conditions=react-server scripts/migrate-prospects.ts",
    "prospects:queries": "bun scripts/maps-queries.ts"
  },
  "dependencies": {
    "lucide-react": "0.575.0",
    "maplibre-gl": "5.24.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
